<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="TT_Colaborador.SiteMaster" %>

<%@ Import Namespace="TT_Colaborador" %>

<!DOCTYPE html>
<html lang="pt-br" style="width: 100%; height: 100vh;">

<head runat="server">
    <title>
        <%= TT_Colaborador.FrameWork.Identity.sNomeSistema %>
        <asp:Literal ID="litComplemento" runat="server" />
        <%= TT_Colaborador.FrameWork.Identity.sVersao %>
    </title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-bs4.min.css" rel="stylesheet" />
    <link href="/aplicativo/css/font-awesome/css/all.min.css" rel="stylesheet" />
    <link href="/aplicativo/css/bootdey-template.css" rel="stylesheet" />
    <link href="/aplicativo/css/jquery-ui.min.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.12.1/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/chosen/1.8.7/chosen.min.css" />

    <script type="text/javascript" src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script type="text/javascript" src="https://code.jquery.com/ui/1.14.1/jquery-ui.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-bs4.min.js"></script>
    <script src="https://cdn.datatables.net/1.12.1/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.12.1/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/chosen/1.8.7/chosen.jquery.min.js"></script>
    <script src="https://login.tecandtec.com.br/app/js/plugins/jquery.mask.js"></script>
    <script> $ = jQuery.noConflict();</script>

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>

<body style="width: 100%; height: 100vh; margin: 0 !important;">

    <style>
        .ui-corner-all {
            z-index: 1;
        }

        .bg-custom {
            background-image: linear-gradient(rgb(0, 125, 0) 0, rgb(0, 115, 0) 12.5%, rgb(0, 105, 0) 25%, rgb(0, 95, 0) 37.5%, rgb(0, 85, 0) 50%, rgb(0, 75, 0) 62.5%, rgb(0, 65, 0) 75%, rgb(0, 55, 0) 87.5%, rgb(0, 45, 0) 100%);
        }

        .card-tt {
            color: white !important;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-control, .form-select {
            border-color: #ccc;
        }

            .form-control[readonly] {
                background-color: #eee;
                border-color: #ccc;
            }

            .form-control:disabled {
                background-color: #eee;
                border-color: #ccc;
            }

            .form-select:disabled {
                background-color: #eee !important;
                border-color: #ccc !important;
            }

        .col-lg-1, .col-lg-2, .col-lg-3, .col-lg-4, .col-lg-5, .col-lg-6, .col-lg-7, .col-lg-8, .col-lg-9, .col-lg-10, .col-lg-11, .col-lg-12,
        .col-1, .col-2, .col-3, .col-4, .col-5, .col-6, .col-7, .col-8, .col-9, .col-10, .col-11, .col-12 {
            padding: 0 20px 10px 20px;
        }

        .card-header {
            margin-bottom: 15px;
        }

        .header-divisor {
            color: black;
            opacity: 1;
        }

        .ml-auto {
            flex-direction: row;
        }

        .thumb-lg {
            margin-right: 2%;
            width: 6.5rem;
            height: 6.5rem;
        }

        .ui-dialog .ui-dialog-buttonset button {
            border-radius: 5px !important;
            padding: 2.5px 5px !important;
        }

        .full-line {
            width: 100%;
        }

        .CaixaTextoMini {
            width: 100px;
        }

        .margin-left-0 {
            margin-left: 0;
        }

        .painelInformacao {
            border: 1px dashed #ccc;
            overflow: hidden;
            padding: .25em .75em;
        }

        .last-modification {
            clear: both;
            line-height: 22px;
            margin-top: 10px !important;
            margin-bottom: 10px;
            padding-bottom: 0 !important;
        }

        .badge-group {
            display: flex;
            flex-wrap: wrap;
            gap: 2px;
        }

        .table.table-bordered.dataTable {
            border-top: solid 1px #ddd;
        }

        .div-flex {
            display: flex;
            flex-wrap: wrap;
        }

        .div-flex-no {
            display: flex;
            flex-wrap: nowrap;
        }

        .just-start {
            justify-content: start;
        }

        .just-end {
            justify-content: end;
        }

        .just-center {
            justify-content: center;
        }

        .space-a {
            justify-content: space-around;
        }

        .space-b {
            justify-content: space-between;
        }

        .space-e {
            justify-content: space-evenly;
        }

        .padd-0 {
            padding: 0;
        }

        .margin-0 {
            margin: 0;
        }

        .modal-xxl {
            width: 75%;
            max-width: 100% !important;
        }

        .modal-max {
            width: 90%;
            max-width: 90% !important;
        }

        .modal-full {
            width: 100% !important;
            max-width: 100% !important;
        }

        .btn-default {
            border: 1px solid black;
        }

        .modal-title {
            color: #009A22;
            font-size: 1.5em;
            font-weight: bolder;
            text-shadow: 2px 2px 2px rgba(0, 0, 0, 0.2);
        }

        .card-header i.fa {
            margin-right: .25em;
        }

        .font-25 {
            font-size: 35px !important;
        }

        .font-22 {
            font-size: 25px !important;
        }

        .font-20 {
            font-size: 20px !important;
        }

        .font-19 {
            font-size: 16px !important;
        }

        .font-18 {
            font-size: 15px !important;
        }

        .mt-10 {
            margin-top: 10rem !important;
        }

        .ui-tooltip {
            z-index: 1000;
        }

        .form-label {
            font-weight: bolder;
            margin-bottom: .1rem;
        }

        .form-range {
            -webkit-appearance: none;
            appearance: none;
            width: 100%;
            background-color: transparent;
            --progress: 0;
        }

            .form-range::-webkit-slider-runnable-track {
                height: .5rem;
                border-radius: 5px;
                background: linear-gradient( to right, #4CAF50 var(--progress), #ddd var(--progress) );
            }

            .form-range::-webkit-slider-thumb {
                -webkit-appearance: none;
                appearance: none;
                width: 1.5rem;
                height: 1.5rem;
                background-color: #4CAF50;
                border-radius: 50%;
                border: 2px solid #333;
                cursor: pointer;
                margin-top: calc((.5rem - 1.5rem) / 2);
            }

                .form-range::-webkit-slider-thumb:hover {
                    background-color: lightgreen;
                }

        .form-switch {
            display: flex;
            flex-wrap: wrap;
            justify-content: start;
        }

        .form-check-switch {
            width: 7.5rem !important;
            margin: 0 !important;
            height: 2rem;
        }

            .form-check-switch:not(:checked) {
                border-color: black;
            }

        .form-check-label {
            font-weight: bold;
            width: 100%;
        }

        .input-group-text {
            border-color: #eee;
            background-color: #eee;
        }

        input[type="range"]:disabled, input[type="radio"]:disabled {
            accent-color: red;
            cursor: not-allowed;
        }

        /*----------------------------------------------------------------*/
        /* Estilo para padronizar o Chosen */

        .chosen-container {
            border: 1px solid #ccc;
            border-radius: 4px;
            padding: .25px;
        }

            .chosen-container .chosen-drop {
                z-index: 1;
            }

        .chosen-container-single .chosen-single {
            width: 100%;
            height: 31.78px;
            background: white;
            border: none;
            font: 14px arial;
            align-content: center;
        }

            .chosen-container-active.chosen-with-drop .chosen-single,
            .chosen-container-single .chosen-single:focus {
                border-color: #66afe9;
                box-shadow: 0 0 10px rgba(102, 175, 233, .6);
                border-radius: 4px 4px 0 0;
            }

        .chosen-container .chosen-results {
            font-size: 14px;
        }

            .chosen-container .chosen-results li {
                padding: 5px 6px;
                line-height: 20px;
            }

                .chosen-container .chosen-results li.highlighted {
                    background-color: #f5f5f5;
                    color: #262626;
                }

                .chosen-container .chosen-results li.active-result {
                    cursor: pointer;
                }

                .chosen-container .chosen-results li.no-results {
                    color: #999999;
                }

        .chosen-container .chosen-search input[type="text"] {
            margin: 0;
            padding: 8px 4px;
            width: 100%;
            font-size: 14px;
        }

        .chosen-disabled {
            cursor: not-allowed !important;
            background-color: #eee !important;
            opacity: 1 !important;
            background: #eee !important;
        }

            .chosen-disabled .chosen-single {
                cursor: not-allowed !important;
                background-color: #eee !important;
                opacity: 1 !important;
                background: #eee !important;
            }

        /*----------------------------------------------------------------*/
        /* Estilo para a Tela de Loading, incluindo suas animações */

        @keyframes rotate {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }

        .modal {
            z-index: 3000;
            width: 100%;
            height: 100vh;
            background-color: rgba(0,0,0,0.3);
        }

        .loading {
            display: flex;
            width: 100%;
            height: 100vh;
            text-align: center;
            align-content: center;
            align-items: center;
            justify-content: center;
            justify-items: center;
            font-size: 50px;
            flex-wrap: wrap;
        }

        .imgLoading {
            max-width: 150px;
            max-height: 170px;
            animation: rotate 2.75s linear infinite;
        }

        @keyframes loading {
            0% {
                content: 'Aguarde';
            }

            25% {
                content: 'Aguarde.';
            }

            50% {
                content: 'Aguarde..';
            }

            75% {
                content: 'Aguarde...';
            }
        }

        .animacao_txt::before {
            content: 'Aguarde';
            display: inline-block;
            animation: loading 2s linear infinite;
        }

        /*----------------------------------------------------------------*/
        /* Estilo da Marca D'água no DEV */

        .marcaDagua {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-30deg);
            font-size: 8vw;
            color: rgba(0, 0, 0, 0.15);
            pointer-events: none;
            z-index: 1;
            width: auto;
            height: auto;
        }

        /*----------------------------------------------------------------*/
        /* Estilos para o Menu das Páginas do Sistema - Lado Esquerdo */

        .cmdMenuPaginas {
            cursor: pointer;
        }

        .menuPaginas {
            display: flex;
            flex-direction: column;
            padding: 20px;
            position: fixed;
            left: -100%;
            top: 0;
            width: 30vw;
            height: 100vh;
            background-color: rgba(245, 255, 245);
            z-index: 10;
            transition: left 0.3s ease-in-out;
            border-right: 1px solid green;
        }

            .menuPaginas.menuPaginas_Ativo {
                left: 0;
            }

        .menuIcon_Abrir {
            display: flex;
            justify-content: center;
            align-items: center;
            max-width: 75%;
            padding: 0 10px;
            align-self: center;
            border: 1px solid white;
            border-radius: 15px;
            background-color: rgba(255, 255, 255, .75);
            color: rgb(0, 155, 0);
            font-size: 3rem;
            aspect-ratio: 1;
            transition: 0.25s ease;
            cursor: pointer;
        }

        .menuPaginas_Fechar {
            width: 5rem;
            height: 5rem;
            object-fit: contain;
            margin: 0 auto;
        }

        .menu-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: relative;
        }

            .menu-top .thumb-lg {
                width: 100px;
                height: 100px;
                border-radius: 50%;
            }

        .direita {
            right: 0;
        }

        .esquerda {
            left: 0;
        }

        .fecharMenu {
            position: absolute;
            top: 0;
            font-size: 1.5rem;
            cursor: pointer;
        }

        .menu-body {
            position: relative;
            height: 100%;
            padding-top: 10px;
        }

        .paginas {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
        }

        .lnkPaginas {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: .5em;
            border: 1px solid black;
            border-radius: 5px;
            width: 32% !important;
            height: max-content !important;
            font-size: 1.25rem;
            padding: 5px;
            cursor: pointer;
        }

            .lnkPaginas:hover {
                border: 2px solid green;
            }

                .lnkPaginas:hover > a {
                    color: green;
                }

            .lnkPaginas > a {
                color: black;
                text-decoration: none;
            }

        .lnkLogOff {
            position: absolute;
            width: 100% !important;
            bottom: 0;
            border-color: red !important;
        }

            .lnkLogOff > a {
                color: red !important;
            }

        /*----------------------------------------------------------------*/
        /* Estilos para Dispositivos Móveis */

        @media only screen and (max-device-width: 768px) {

            .menuPaginas {
                width: 100vw !important;
            }

            .menuPaginas_Abrir {
                font-size: 5rem !important;
                padding: 0 15px !important;
            }

            .menuPaginas_Fechar {
                width: 10rem !important;
                height: 10rem !important;
            }

            .fecharMenu {
                font-size: 5em;
            }

            .lnkPaginas {
                width: 48.5% !important;
                border-radius: 15px;
                min-height: 3.5em !important;
                font-size: 2.5rem;
            }

                .lnkPaginas i {
                    font-size: 3rem;
                }

            .lnkLogOff {
                width: 100% !important;
            }

            .invalid-feedback {
                font-size: 2rem;
            }

            .form-control, .form-select, .card {
                border-color: black;
            }

            .form-control, .form-select, .form-label,
            .input-group-text,
            .alert,
            .btn,
            .font-15,
            .nav-borders a,
            .ui-dialog .ui-dialog-content,
            footer p, label b, b label, strong {
                font-size: 2rem !important;
            }

            .font-25 {
                font-size: 3.5rem !important;
            }

            h1,
            .font-22 {
                font-size: 3rem !important;
            }

            h2,
            .close-icon,
            .font-20 {
                font-size: 2.7rem !important;
            }

            h3,
            .font-19 {
                font-size: 2.5rem !important;
            }

            h4,
            .font-18,
            .ui-dialog .ui-dialog-titlebar,
            .ui-dialog .ui-dialog-buttonset,
            .form-check-label {
                font-size: 2.15rem !important;
            }

            h5,
            .font-16, 
            .last-modification {
                font-size: 1.75rem !important;
            }

            h6,
            .font-13,
            .ribbon {
                font-size: 1.5rem !important;
            }

            .marcaDagua {
                font-size: 10vw !important;
            }

            .ml-auto {
                font-size: 1.75rem !important;
                flex-direction: column !important;
            }

            .ui-dialog {
                width: 90vw !important;
            }

            #imgColaborador {
                width: 9.5rem !important;
                height: 9.5rem !important;
            }

            .form-range::-webkit-slider-runnable-track {
                height: 1rem;
            }

            .form-range::-webkit-slider-thumb {
                width: 2rem;
                height: 2rem;
                border: 4px solid #333;
                margin-top: calc((1rem - 2rem) / 2);
            }

            .form-check-switch {
                width: 100% !important;
                height: 3rem;
            }
        }

        /*----------------------------------------------------------------*/
    </style>

    <form id="frmTT_Colaborador" runat="server" style="width: 100%; height: 100vh;">

        <div id="hdd">
            <asp:HiddenField runat="server" ID="hddLatitude" />
            <asp:HiddenField runat="server" ID="hddLongitude" />
        </div>

        <asp:ScriptManager ID="sm_main" runat="server" EnableCdn="false"></asp:ScriptManager>

        <div class="content container-fluid cor-content" style="width: 100%; height: 100vh; padding: 0; overflow: auto;">

            <asp:UpdatePanel ID="UpdatePanel1" runat="server">
                <ContentTemplate>

                    <div class="col-sm-12">
                        <div class="profile-user-box card-box bg-custom">

                            <div class="row">

                                <div class="col-lg-1" style="display: flex; width: 20%; justify-content: start;">
                                    <div class="menuIcon_Abrir cmdMenuPaginas">
                                        <i class="fa fa-list-ul menuPaginas_Abrir"></i>
                                    </div>
                                </div>

                                <div class="col-lg-11" style="display: flex; justify-content: right; width: 80% !important;">
                                    <asp:HyperLink runat="server" ID="hplPerfil" NavigateUrl="/Aplicativo/MenuColaborador.aspx" Style="display: flex; justify-content: right; width: max-content; text-decoration: none;">

                                        <div class="media-body text-white" style="width: max-content; margin-right: 2.5rem;">
                                            <p class="mt-1 mb-1 font-25" style="width: max-content; margin: 0;">
                                                <asp:Literal ID="ltrNome" runat="server" />
                                            </p>
                                            <p class="font-15 text-light" style="width: max-content; margin: 0;">
                                                <asp:Literal ID="ltrEmail" runat="server" />
                                            </p>
                                        </div>

                                        <asp:Image ID="imgColaborador" runat="server" class="thumb-lg rounded-circle" Style="border: 2px solid lightgreen;" />

                                    </asp:HyperLink>
                                </div>

                            </div>

                        </div>
                    </div>

                    <div id="menuPaginas" class="menuPaginas">

                        <div class="menu-top cmdMenuPaginas">
                            <div data-bs-toggle="tooltip_right" title="Recarregar Permissões" class="text-center fecharMenu esquerda" style="width: max-content !important; height: max-content !important;">
                                <asp:LinkButton ID="lnkRecarregaMenu" runat="server" OnClick="lnkRecarregaMenu_Click" Style="text-decoration: none; color: black;"><i class="fa fa-refresh"></i></asp:LinkButton>
                            </div>
                            <img src="/Aplicativo/img/LogoTT.png" alt="Logo Tec And Tec" class="menuPaginas_Fechar" />
                            <i class="fa fa-times fecharMenu direita"></i>
                        </div>

                        <div class="menu-body">

                            <p class="text-center font-25 mt-2">
                                <b>
                                    <asp:Literal ID="ltrNome_TT" runat="server" />
                                </b>
                            </p>

                            <p class="text-center font-19 mt-4 mb-1">
                                <asp:Literal ID="ltrNome_Sistema" runat="server" />
                            </p>

                            <div class="paginas">
                                <asp:Literal ID="ltrMaster" runat="server" />
                            </div>

                            <div class="text-center mt-10 lnkPaginas lnkLogOff">
                                <asp:HyperLink ID="lnkLogOff" runat="server" NavigateUrl="/Aplicativo/login.aspx?LogOut=S"><i class="fa fa-power-off"></i> Log Out</asp:HyperLink>
                            </div>

                        </div>

                    </div>

                </ContentTemplate>
            </asp:UpdatePanel>

            <div id="div_ContentPage" class="col-lg-12">

                <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>

                <div runat="server" id="divMarcaDagua" class="marcaDagua"><b>DESENVOLVIMENTO</b></div>

                <div id="div_Loading" style="display: none;">
                    <div id="div_img" class="modal">
                        <div class="loading">
                            <div style="width: 100%;">
                                <asp:Image ImageUrl="~\Aplicativo\img\LogoTT.png" runat="server" ID="imgLoading" CssClass="imgLoading" />
                            </div>
                            <br />
                            <b class="animacao_txt"></b>
                        </div>
                    </div>
                </div>

                <br />

                <footer class="col-md-12">
                    <p>&copy; <%= DateTime.Now.Year %> Área Colaborador. Todos os direitos reservados.</p>
                </footer>

            </div>

        </div>

    </form>

</body>
</html>